  "other_words": [
    { "text": "２．鴨居ベース・鴨居レールをのせた後、１で敷いたポリシートで包む",
      "pixel": { "x": 3452, "y": 249, "w": 2432, "h": 71 },
      "pdf_mm": { "x": 292.27, "y": 21.08, "w": 205.91, "h": 6.01 } },
    { "text": "３．鴨居レールにダンボールパッドをセットし、間に戸当りを入れる。",
      "pixel": { "x": 6510, "y": 249, "w": 2385, "h": 72 },
      "pdf_mm": { "x": 551.18, "y": 21.08, "w": 201.93, "h": 6.10 } },
