<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{8F3A2C1E-4B7D-4E9A-9C2F-1A2B3C4D5E6F}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>CadPartSplitter</RootNamespace>
    <AssemblyName>CadPartSplitter</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <Deterministic>true</Deterministic>
    <LangVersion>7.3</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <!--
      用 PackageReference 还原带原生库的包时，NuGet 要求项目把会实际用到的 RID 显式写进
      RuntimeIdentifiers，否则会报：
        Your project file doesn't list 'win-x64' as a "RuntimeIdentifier".
        You should add 'win-x64' to the "RuntimeIdentifiers" property in your project file
        and then re-run NuGet restore.
      Docnet.Core（runtimes\win-x64、win-x86）与 OpenCvSharp4.runtime.win（同样只有 win-x64 / win-x86）
      都需要；本工程固定 x64（见下方 PlatformTarget / Prefer32Bit / DocnetRuntime）。
    -->
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!--
      本程序以 x64 运行（见下方 PlatformTarget）。
      Prefer32Bit 若不显式关闭，Docnet.Core 的 build targets 会误判为 32 位平台，
      从而把 runtimes\win-x86\native\pdfium.dll 拷贝到输出目录，
      导致 x64 进程加载 PDFium 时抛出 BadImageFormatException。
    -->
    <Prefer32Bit>false</Prefer32Bit>
    <DocnetRuntime>win-x64</DocnetRuntime>
    <PublishUrl>publish\</PublishUrl>
    <Install>true</Install>
    <InstallFrom>Disk</InstallFrom>
    <UpdateEnabled>false</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateInterval>7</UpdateInterval>
    <UpdateIntervalUnits>Days</UpdateIntervalUnits>
    <UpdatePeriodically>false</UpdatePeriodically>
    <UpdateRequired>false</UpdateRequired>
    <MapFileExtensions>true</MapFileExtensions>
    <ApplicationRevision>0</ApplicationRevision>
    <ApplicationVersion>1.0.0.%2a</ApplicationVersion>
    <IsWebBootstrapper>false</IsWebBootstrapper>
    <UseApplicationTrust>false</UseApplicationTrust>
    <BootstrapperEnabled>true</BootstrapperEnabled>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>..\MSIFAITOOLS\bin\Debug\CadPartSplitter\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <!-- AI 判定（--tz-ai）：OpenAI 兼容接口用 HttpClient，响应 JSON 用 JavaScriptSerializer，密钥用 DPAPI 解 -->
    <Reference Include="System.Configuration" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="CommandLineRunner.cs" />
    <Compile Include="BatchRunner.cs" />
    <Compile Include="SplitApi.cs" />
    <Compile Include="SplitResult.cs" />
    <Compile Include="GuiSettings.cs" />
    <Compile Include="MainForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="MainForm.Designer.cs">
      <DependentUpon>MainForm.cs</DependentUpon>
    </Compile>
    <Compile Include="PartSplitterService.cs" />
    <Compile Include="PartDetector.cs" />
    <Compile Include="PdfRenderer.cs" />
    <Compile Include="DetectorOptions.cs" />
    <Compile Include="PartInfo.cs" />
    <Compile Include="PartText.cs" />
    <Compile Include="PartTextExtractor.cs" />
    <Compile Include="RuledTable.cs" />
    <Compile Include="RuledTableExtractor.cs" />
    <Compile Include="RuledTableWriter.cs" />
    <Compile Include="CsvFile.cs" />
    <Compile Include="LtStep1Builder.cs" />
    <Compile Include="LtStep2Builder.cs" />
    <Compile Include="AssemblyYoryoBuilder.cs" />
    <Compile Include="DrawingListBuilder.cs" />
    <Compile Include="PdfInfo.cs" />
    <Compile Include="TzJsonBuilder.cs" />
    <!-- Excel 部品表的 AI 判定与补足（--tz-ai）：配置 → HTTP 客户端 → 提示语 → 响应解析 → 回原表核对 -->
    <Compile Include="TzAiMode.cs" />
    <Compile Include="AiApiOptions.cs" />
    <Compile Include="ChatCompletionClient.cs" />
    <Compile Include="TzAiPromptStore.cs" />
    <Compile Include="TzAiResponseParser.cs" />
    <Compile Include="TzAiExtractor.cs" />
    <!-- 非 Excel 的特注品文件（第 5 位 Z 的 PDF / 文本）：读正文 → AI 判明细 → 回正文核对 -->
    <Compile Include="TzSourceTextReader.cs" />
    <Compile Include="TzFileAiPromptStore.cs" />
    <Compile Include="TzFileAiExtractor.cs" />
    <Compile Include="PdfInfoEditorForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="PdfInfoEditorForm.Designer.cs">
      <DependentUpon>PdfInfoEditorForm.cs</DependentUpon>
    </Compile>
    <Compile Include="Callout.cs" />
    <Compile Include="CalloutExtractor.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="App.config" />
    <None Include="README.md" />
    <None Include="docs\分割原理.md" />
    <None Include="_test\gen_test_drawing.ps1" />
    <None Include="_test\gen_test_raster.ps1" />
    <None Include="_test\gui_shot.ps1" />
    <None Include="_test\api_probe.ps1" />
    <None Include="_test\gui_output_probe.ps1" />
    <None Include="_test\gui_batch_probe.ps1" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="OpenCvSharp4">
      <Version>4.10.0.20240616</Version>
    </PackageReference>
    <PackageReference Include="OpenCvSharp4.runtime.win">
      <Version>4.10.0.20240616</Version>
    </PackageReference>
    <PackageReference Include="Docnet.Core">
      <Version>2.6.0</Version>
    </PackageReference>
    <!-- PdfPig 只用于读取 PDF 文字层（文字内容 + 词框坐标），不参与渲染与分割 -->
    <PackageReference Include="PdfPig">
      <Version>0.1.9</Version>
    </PackageReference>
    <!--
      只读 Excel（.xls / .xlsx / .xlsm）用的轻量库：tz.json 要读部品表的「カメラ」sheet。
      不依赖机器上装没装 Excel，也没有传递依赖（net45 / netstandard2.0 组都是空的）。
    -->
    <PackageReference Include="ExcelDataReader">
      <Version>3.6.0</Version>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="MainForm.resx">
      <DependentUpon>MainForm.cs</DependentUpon>
    </EmbeddedResource>
    <!--
      Excel 部品表 AI 判定的提示语（--tz-ai）：
      同一份文件既编译进 exe（外部文件缺失时兜底），又复制到输出目录（可运行时修改、不用重新编译）。
    -->
    <EmbeddedResource Include="Prompts\TzJsonAi.Prompt.txt">
      <LogicalName>CadPartSplitter.Prompts.TzJsonAi.Prompt.txt</LogicalName>
    </EmbeddedResource>
    <None Include="Prompts\TzJsonAi.Prompt.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!--
      非 Excel 特注品文件（第 5 位 Z 的 PDF / 文本）AI 判定的提示语：
      同样「编译进 exe 兜底 + 复制到输出目录可运行时修改」。
    -->
    <EmbeddedResource Include="Prompts\TzJsonFileAi.Prompt.txt">
      <LogicalName>CadPartSplitter.Prompts.TzJsonFileAi.Prompt.txt</LogicalName>
    </EmbeddedResource>
    <None Include="Prompts\TzJsonFileAi.Prompt.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <BootstrapperPackage Include=".NETFramework,Version=v4.8">
      <Visible>False</Visible>
      <ProductName>Microsoft .NET Framework 4.8 %28x86 および x64%29</ProductName>
      <Install>true</Install>
    </BootstrapperPackage>
    <BootstrapperPackage Include="Microsoft.Net.Framework.3.5.SP1">
      <Visible>False</Visible>
      <ProductName>.NET Framework 3.5 SP1</ProductName>
      <Install>false</Install>
    </BootstrapperPackage>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>