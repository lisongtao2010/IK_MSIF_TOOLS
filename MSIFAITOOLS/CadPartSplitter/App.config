<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <!--
    Excel 部品表的 AI 判定（--tz-ai）用的 OpenAI 兼容接口。
    密钥三处任选其一：环境变量 MSIF_AI_API_KEY / MSIFAITOOLS 的【AI 设置】
    （%APPDATA%\MSIFAITOOLS\ai-settings.json，可共用）/ 下面的 appSettings。
    这里不填也不会报错：没配密钥时只记日志「AI 判定已跳过」，tz.json 的规则结果照常输出。
  -->
  <appSettings>
    <!-- <add key="AiApiKey" value="sk-..." /> -->
    <!-- <add key="AiBaseUrl" value="https://api-ap-southeast-1.modelarts-maas.com/v1" /> -->
    <!-- <add key="AiModel" value="deepseek-v4-flash" /> -->
    <!-- <add key="AiTimeoutSeconds" value="180" /> -->
  </appSettings>
  <System.Windows.Forms.ApplicationConfigurationSection>
    <!-- 启用系统级 DPI 感知，配合 MainForm 的 AutoScaleMode.Dpi 让高分屏界面不模糊 -->
    <add key="DpiAwareness" value="System" />
  </System.Windows.Forms.ApplicationConfigurationSection>
</configuration>
