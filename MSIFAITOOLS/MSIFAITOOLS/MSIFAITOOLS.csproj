  <!--
    原 CadPartSplitter 工程的源码直接编译进本程序：一个 MSIFAITOOLS.exe 就能做零件分割，
    不再需要外部 CadPartSplitter.exe 子进程。用「链接」而不是把文件复制过来，
    保证两边只有一份源码，改一处即生效。

    排除项及原因：
      Program.cs                  → 自带 Main，会和本程序 Program.cs 的 Main 冲突（CS0017）
      CommandLineRunner.cs        → 命令行模式（参数解析 + Console 输出），界面里用不到
      MainForm.cs / .Designer.cs  → 分割工程自带的窗口（本程序用 Form1）
      PdfInfoEditorForm.*         → 上面那个窗口的部品表编辑对话框
                                    （GuiSettings.cs 不排除：它只依赖 DetectorOptions，
                                      不含窗口代码，SplitApi 的调用示例也会用到它）
      PdfRenderer.cs              → 用 Docnet.Core 渲染；本工程改用 PdfiumViewer 重写
                                    （见本工程 CadPartSplitter\PdfRenderer.cs），
                                    否则 Docnet.Core 与 PdfiumViewer 的同名原生库
                                    pdfium.dll 会在输出目录里互相覆盖
  -->
  <ItemGroup>
    <!-- 合并后本工程自己的渲染实现（PdfiumViewer），API 与原 Docnet.Core 版一致 -->
    <Compile Include="CadPartSplitter\PdfRenderer.cs" />
    <Compile Include="..\CadPartSplitter\*.cs" Exclude="..\CadPartSplitter\Program.cs;..\CadPartSplitter\CommandLineRunner.cs;..\CadPartSplitter\MainForm.cs;..\CadPartSplitter\MainForm.Designer.cs;..\CadPartSplitter\PdfInfoEditorForm.cs;..\CadPartSplitter\PdfInfoEditorForm.Designer.cs;..\CadPartSplitter\PdfRenderer.cs;..\CadPartSplitter\DetectorOptions.cs">
      <Link>CadPartSplitter\%(Filename)%(Extension)</Link>
    </Compile>
    <!--
      DetectorOptions.cs 单独显式列出（上面通配符里已经 Exclude 掉，不会重复编译）。

      原因：这个文件是所有分割参数的「单一真源」——GuiSettings.cs 的默认值、
      SplitApi / BatchRunner / PartSplitterService 的参数类型都直接依赖它。
      走通配符时，若某次项目加载 / 增量构建没有正确展开 ..\CadPartSplitter\*.cs，
      CadPartSplitter 命名空间会由本工程的 CadPartSplitter\PdfRenderer.cs 顶住，
      于是只报一条：
        CS0234 型または名前空間の名前 'DetectorOptions' が名前空間 'CadPartSplitter' に存在しません
      显式列出后，DetectorOptions 一定参与编译，不再受通配符展开结果影响。
      以后在主工程里新增其他 .cs 仍由通配符自动带入，本行不必改动。
    -->
    <Compile Include="..\CadPartSplitter\DetectorOptions.cs" Link="CadPartSplitter\DetectorOptions.cs" />
    <!-- Excel 部品表 AI 判定的提示语：编译进 exe 作兜底，同时复制到输出目录（可运行时修改、不用重新编译） -->
    <EmbeddedResource Include="..\CadPartSplitter\Prompts\TzJsonAi.Prompt.txt">
      <LogicalName>CadPartSplitter.Prompts.TzJsonAi.Prompt.txt</LogicalName>
    </EmbeddedResource>
    <None Include="..\CadPartSplitter\Prompts\TzJsonAi.Prompt.txt">
      <Link>Prompts\TzJsonAi.Prompt.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
