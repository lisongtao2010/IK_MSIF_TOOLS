<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <!--
      注意：不要用 configSections 节点声明 System.Windows.Forms.ApplicationConfigurationSection。
      该节在 .NET Framework 4.8 中已由框架内置注册，重复声明会导致配置系统初始化失败
      （構成システムを初期化できませんでした），进而使 ConfigurationManager.AppSettings 全部读不到，
      表现为 AiApiKey 明明已填写却一直提示“未配置密钥”。
    -->
    <System.Windows.Forms.ApplicationConfigurationSection>
        <add key="DpiAwareness" value="PerMonitorV2" />
    </System.Windows.Forms.ApplicationConfigurationSection>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <appSettings>
        <!-- AI（OpenAI 兼容接口）配置
             优先级：环境变量 MSIF_AI_API_KEY / MSIF_AI_BASE_URL / MSIF_AI_MODEL / MSIF_AI_TIMEOUT_SECONDS
                    → 程序内【AI 设置】画面保存的 %APPDATA%\MSIFAITOOLS\ai-settings.json
                    → 本文件的 appSettings（下面这几项仅为初始默认值） -->
        <add key="AiBaseUrl" value="https://api-ap-southeast-1.modelarts-maas.com/v1" />
        <add key="AiApiKey" value="RG1wlfD1ixUC0DOfX4HJw7KHc_orZYD7_KJw2gxoVjBtAVWCGSKN1JwBcKHYsf-BR2FzDtlMgTiyOVFA4rPCKQ" />
        <add key="AiModel" value="deepseek-v4-flash" />
        <add key="AiTimeoutSeconds" value="180" />
        <!-- 部品基本信息数据库：相对路径按程序目录解析，默认 Data\MSIF_Parts.db -->
        <add key="PartDatabasePath" value="Data\MSIF_Parts.db" />
        <!-- 部材部品マスタ（原 部材部品\部材部品.csv）的 SQLite 数据库。
             留空 / 不写时默认 D:\MSIFDB\MSIF_MemberParts.db（D 盘不可用时退回 程序目录\Data\MSIF_MemberParts.db）；
             也可以只写文件夹（自动补 MSIF_MemberParts.db），相对路径按程序目录解析。
             环境变量 MSIF_MEMBER_PARTS_DB 优先级更高。
             第一次运行会把 部材部品\部材部品.csv 导入「部材部品」表，之后只读数据库；
             要重新导入，清空该表或删掉数据库文件即可。
             同一个库里还有「部材名置换」表：主画面的【部材名置换表】按钮维护
             （置换前 → 置换后，例：鴨居 → 上枠；保存后部材名在分析 / 保存时自动置换）。 -->
        <add key="MemberPartDatabasePath" value="D:\MSIFDB\MSIF_MemberParts.db" />
    </appSettings>

</configuration>